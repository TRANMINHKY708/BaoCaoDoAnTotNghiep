# Public configuration only. NEVER add a token/password/API key to VITE_*.
# /backend is a loopback-only Vite development proxy, not a production default.
VITE_API_BASE_URL=/backend
# Username/password login is the application default. No secret goes here.
VITE_AUTH_PROFILE=accounts
# Proxy target is server-side dev configuration, never a credential or API key.
FRONTEND_PROXY_TARGET=http://127.0.0.1:8000
