# Copy this file to .env and replace credentials locally.
# Never commit the real .env file.
DATABASE_URL=postgresql+psycopg://ecommerce_app:CHANGE_ME@localhost:5432/ecommerce_ai
TEST_DATABASE_URL=postgresql+psycopg://ecommerce_app:CHANGE_ME@localhost:5432/ecommerce_ai_test
DATABASE_ECHO=false

# Default preserves the accepted local-only API. Never expose local mode publicly.
SECURITY_PROFILE=local
# For secured mode generate two distinct random urlsafe tokens (>=32 random bytes).
# Do not put credentials in URLs, browser bundles, logs or Git.
SECURITY_VIEWER_TOKEN=CHANGE_ME
SECURITY_OPERATOR_TOKEN=CHANGE_ME
SECURITY_CORS_ORIGINS=[]
SECURITY_REQUESTS_PER_MINUTE=60
SECURITY_PREDICTION_PER_MINUTE=20
SECURITY_WHAT_IF_PER_MINUTE=30
SECURITY_CSV_PER_MINUTE=5
SECURITY_AUTH_FAILURES_PER_MINUTE=10
SECURITY_MAX_INFLIGHT=2

# Optional Gemini assistant. Set the real key only in your ignored local .env.
# PowerShell environment variables take precedence over these values.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.5-flash-lite
